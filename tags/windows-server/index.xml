    alt=&#34;step4&#34; 
     
    width=1400 
    height=&#34;1131&#34;  /&gt;
&lt;img loading=&#34;lazy&#34; 
    src=&#34;https://example.com/post/install-windows-server/step5.webp&#34; 
    alt=&#34;step5&#34; 
     
